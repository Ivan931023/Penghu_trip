rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email in [
          'ivanchen931023@gmail.com',
          'yiyiz1120@gmail.com'
        ];
    }

    match /{allPaths=**} {
      allow read, write: if isAllowed();
    }
  }
}
